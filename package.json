{
  "name": "likeme-front-end",
  "version": "1.21.3",
  "description": "React Native app for health and wellness",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "build:android:local": "./build-android-local.sh",
    "run:emulator:ios": "bash scripts/ios-simulator.sh",
    "ios:xcode:build:debug": "cd ios && xcodebuild -workspace LikeMe.xcworkspace -scheme LikeMe -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/DerivedData clean build",
    "run:emulator:android": "./start-emulator.sh",
    "start": "npx expo start --dev-client --reset-cache --clear",
    "start:ios:production": "bash scripts/clear-expo-metro-cache.sh && npx env-cmd -f .env.production npx expo run:ios",
    "start:ios:staging": "npx env-cmd -f .env.staging npx expo run:ios",
    "start:ios": "npx env-cmd -f .env local npx expo run:ios",
    "start:clear": "bash scripts/clear-expo-metro-cache.sh && npm run start",
    "web": "expo start --web",
    "web:export": "expo export -p web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update": "jest --updateSnapshot",
    "test:e2e": "bash scripts/run-maestro-staging.sh maestro/flows",
    "test:e2e:welcome": "bash scripts/run-maestro-staging.sh maestro/flows/welcome-screen.yaml",
    "test:e2e:objectives": "bash scripts/run-maestro-staging.sh maestro/flows/interest-categories.yaml",
    "test:e2e:onboarding": "bash scripts/run-maestro-staging.sh maestro/flows --include-tags onboarding",
    "test:e2e:journey": "bash scripts/run-maestro-staging.sh maestro/flows/hub-nav.yaml",
    "test:e2e:expo-go": "./maestro/run-expo-go-tests.sh",
    "export:screenshots": "~/.maestro/bin/maestro test maestro/export/export-screenshots.yaml --test-output-dir=.maestro/screenshots",
    "export:screenshots:app": "~/.maestro/bin/maestro test maestro/export/export-screenshots-app.yaml --test-output-dir=.maestro/screenshots",
    "build": "npx tsc --noEmit && npm run lint",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "doctor": "npx expo-doctor",
    "version:sync": "node scripts/sync-app-version.cjs",
    "version:check": "node scripts/sync-app-version.cjs --check",
    "assert:ios-apple-signin": "node scripts/assert-ios-apple-signin.cjs",
    "assert:ios-share-links": "node scripts/assert-ios-share-associated-domains.cjs",
    "native:prebuild": "npm run version:sync && expo prebuild",
    "native:prebuild:clean": "npm run version:sync && expo prebuild --clean",
    "build:android": "env-cmd -f .env.production bash -c 'export JAVA_HOME=$(/usr/libexec/java_home -v 17) && cd android && ./gradlew :app:bundleRelease'",
    "android:keystore:verify": "bash scripts/android-keystore-verify-local.sh",
    "android:keystore:test-b64": "bash scripts/android-keystore-test-github-b64.sh",
    "build:android:gradle": "EXCLUDE_EXPO_DEV_CLIENT=1 npx expo prebuild --platform android && cd android && ./gradlew assembleRelease && cd ..",
    "build:android:apk": "./build-android-apk.sh",
    "ios:pod-install:store": "cd ios && EXCLUDE_EXPO_DEV_CLIENT=1 pod install",
    "ios:xcode:build:release": "cd ios && xcodebuild -workspace LikeMe.xcworkspace -scheme LikeMe -configuration Release -destination 'generic/platform=iOS' -sdk iphoneos -allowProvisioningUpdates build",
    "ios:xcode:build:production": "npm run ios:pod-install:store && cd ios && xcodebuild -workspace LikeMe.xcworkspace -scheme LikeMe -configuration Production -destination 'generic/platform=iOS' -sdk iphoneos -allowProvisioningUpdates build",
    "ios:xcode:archive:release": "cd ios && xcodebuild -workspace LikeMe.xcworkspace -scheme LikeMe -configuration Release -destination 'generic/platform=iOS' -archivePath \"$PWD/build/LikeMe.xcarchive\" -allowProvisioningUpdates archive",
    "ios:xcode:archive:production": "cd ios && xcodebuild -workspace LikeMe.xcworkspace -scheme LikeMe -configuration Production -destination 'generic/platform=iOS' -archivePath \"$PWD/build/LikeMe.xcarchive\" -allowProvisioningUpdates archive",
    "ios:xcode:export": "cd ios && xcodebuild -exportArchive -allowProvisioningUpdates -archivePath \"$PWD/build/LikeMe.xcarchive\" -exportPath \"$PWD/build/export\" -exportOptionsPlist \"$PWD/ExportOptions-AppStore.plist\"",
    "ios:xcode:export-adhoc": "bash -c 'IOS_ADHOC_PROVISIONING_PROFILE=\"Devices Ad Hoc for Dev\" IOS_ADHOC_PROVISIONING_FILE=\"${IOS_ADHOC_PROVISIONING_FILE:-$HOME/Downloads/Devices_Ad_Hoc_for_Dev.mobileprovision}\" exec bash scripts/ios-export-adhoc.sh'",
    "ios:signing:diagnose": "bash scripts/ios-signing-diagnose.sh",
    "ios:appstore:validate": "bash scripts/ios-appstore-altool.sh validate",
    "ios:appstore:upload": "bash scripts/ios-appstore-altool.sh upload",
    "ios:appstore:pipeline": "npm run ios:xcode:build:production && npm run ios:xcode:archive:production && npm run ios:xcode:export && npm run ios:appstore:validate && npm run ios:appstore:upload",
    "ios:archive:export": "bash scripts/archive-and-export-ipa.sh",
    "run:apk": "./run-apk.sh",
    "install:apk": "./install-and-run-apk.sh",
    "clean": "rm -rf node_modules/.cache .expo dist android/build ios/build",
    "clean:all": "rm -rf node_modules/.cache .expo dist android/build ios/build android/app/build ios/Pods ios/Podfile.lock",
    "clean:project": "./scripts/clean-project.sh",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock build && pod install && cd ..",
    "revopush:release:ios": "bash scripts/revopush-release.sh ios",
    "revopush:release:android": "bash scripts/revopush-release.sh android",
    "revopush:release:all": "bash scripts/revopush-release.sh ios Production && bash scripts/revopush-release.sh android Production",
    "postinstall": "node scripts/ensure-onboarding-debug.cjs && node scripts/patch-slider-podspec.js && node scripts/patch-rn-third-party-components-provider.js && node scripts/patch-expo-js-logger.js && node scripts/patch-react-native-sound-ios.js && node scripts/run-jitsi-prepare-sdk.js && node scripts/patch-jitsi-load-config-native.js && if [ -d ios ] && [ -f ios/Podfile ] && [ \"$SKIP_IOS_POD_INSTALL\" != \"true\" ]; then cd ios && pod install && cd ..; fi",
    "prepare": "husky || true",
    "start:staging": "ENV_FILE_PATH=$PWD/.env.staging npx expo start --dev-client --reset-cache --clear",
    "ios:staging": "ENV_FILE_PATH=$PWD/.env.staging npx expo run:ios",
    "test:e2e:staging": "bash scripts/run-maestro-staging.sh maestro/flows",
    "test:e2e:smoke": "bash scripts/run-maestro-staging.sh maestro/flows --include-tags smoke",
    "test:e2e:critical": "bash scripts/run-maestro-staging.sh maestro/flows --include-tags critical",
    "test:e2e:hub": "bash scripts/run-maestro-staging.sh maestro/flows --include-tags hub",
    "test:e2e:login": "bash scripts/run-maestro-staging.sh maestro/flows/login.yaml",
    "test:e2e:checkout": "bash scripts/run-maestro-staging.sh maestro/flows/checkout"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "1.5.16",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~56.0.21",
    "@giphy/react-native-sdk": "5.0.1",
    "@google/react-native-make-payment": "^0.3.1",
    "@jitsi/react-native-sdk": "^13.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/analytics": "^23.8.5",
    "@react-native-firebase/app": "^23.8.5",
    "@react-native-firebase/messaging": "^23.8.5",
    "@react-native-firebase/remote-config": "^23.8.5",
    "@react-native-google-signin/google-signin": "10.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.18.17",
    "@react-navigation/elements": "2.9.39",
    "@react-navigation/native": "7.3.17",
    "@react-navigation/stack": "7.10.23",
    "@revopush/expo-code-push-plugin": "^1.1.0",
    "@revopush/react-native-code-push": "^2.5.0",
    "@sayem314/react-native-keep-awake": "1.4.0",
    "expo": "~56.0.0",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.25",
    "expo-auth-session": "~56.0.19",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-calendar": "~56.0.10",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.27",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.13",
    "expo-image-picker": "~56.0.25",
    "expo-linear-gradient": "~56.0.4",
    "expo-navigation-bar": "~56.0.3",
    "expo-screen-orientation": "~56.0.5",
    "expo-splash-screen": "~56.0.15",
    "i18next": "^25.8.0",
    "promise.withresolvers": "^1.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-native": "0.85.3",
    "react-native-auth0": "^5.4.1",
    "react-native-background-timer": "https://github.com/jitsi/react-native-background-timer.git#d180dfaa4486ae3ee17d01242db92cb3195f4718",
    "react-native-calendar-events": "https://github.com/jitsi/react-native-calendar-events.git#47f068dedfed7c0f72042e093f688eb11624eb7b",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-default-preference": "https://github.com/jitsi/react-native-default-preference.git#c9bf63bdc058e3fa2aa0b87b1ee1af240f44ed02",
    "react-native-device-info": "14.1.1",
    "react-native-gesture-handler": "3.2.1",
    "react-native-get-random-values": "1.11.0",
    "react-native-orientation-locker": "https://github.com/jitsi/react-native-orientation-locker.git#0c42e6f8e9d86397b14b3f03f0ed9b2b73211333",
    "react-native-pager-view": "9.0.4",
    "react-native-paper": "^5.11.1",
    "react-native-performance": "6.0.0",
    "react-native-play-install-referrer": "^1.1.9",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.23.0",
    "react-native-sound": "https://github.com/jitsi/react-native-sound.git#bc92152667a628120374c1324fc9e44f697c3192",
    "react-native-splash-view": "0.0.18",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-vector-icons": "^10.0.2",
    "react-native-video": "6.19.1",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "13.16.1",
    "react-native-worklets-core": "https://github.com/jitsi/react-native-worklets-core.git#8b20145466186a369d13dd38e979642035a9bda1",
    "reselect": "5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.85.0",
    "@react-native/eslint-config": "^0.85.0",
    "@react-native/jest-preset": "^0.85.0",
    "@react-native/metro-config": "^0.85.0",
    "@revopush/code-push-cli": "^0.0.12",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "~19.1.0",
    "babel-jest": "^29.2.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.2.3",
    "env-cmd": "^11.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "~9.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "lint-staged": "^16.2.7",
    "prettier": "^2.4.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-vector-icons|react-native-video|expo|@expo|expo-auth-session|@react-navigation|@react-native-community|@revopush|@jitsi)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "overrides": {
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "@react-navigation/bottom-tabs": "7.18.17",
    "@react-navigation/core": "7.24.0",
    "@react-navigation/elements": "2.9.39",
    "@react-navigation/native": "7.3.17",
    "@react-navigation/routers": "7.4.0",
    "@react-navigation/stack": "7.10.23"
  },
  "lint-staged": {
    "app.version.json": [
      "node scripts/sync-app-version.cjs",
      "node scripts/stage-app-version-sync-outputs.cjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{spec,test}.{ts,tsx}": [
      "prettier --write"
    ]
  }
}
